# Copy to .env and adjust
GUILD_HOME=data
PORT=3847
GUILD_HOUSE_URL=http://127.0.0.1:3847
GUILD_API_KEY=change-me-in-production
CLAUDE_COMMAND=claude
CLAUDE_PERMISSION_MODE=acceptEdits
# Display name for guild master in mission room playbooks (default: Guild Master)
GUILD_MASTER_NAME=GM
MAX_ACTIVE_MISSIONS=4
MAX_DISCOVERY_SESSIONS=2
# Periodic orchestrator tick (minutes). 0 = disabled (manual bell only).
GUILD_TICK_INTERVAL_MINUTES=0
# Comma-separated browser origins for CORS (web UI dev server)
GUILD_UI_ORIGIN=http://127.0.0.1:3848,http://localhost:3848
