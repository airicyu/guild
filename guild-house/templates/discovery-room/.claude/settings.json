{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(.guild/**)",
      "Read(members/**)",
      "Read(scratch.md)",
      "Read(inbox.md)",
      "Read(outbox.jsonl)",
      "Edit(scratch.md)",
      "Edit(artifacts/**)",
      "Edit(outbox.jsonl)",
      "Glob",
      "Grep",
      "Task",
      "Bash(python *)",
      "Bash(py *)",
      "Bash(node *)",
      "Bash(bun *)"
    ],
    "deny": [
      "Edit(checkpoint.yaml)",
      "Edit(.guild/handoff-prompt.md)",
      "Edit(.guild/mission-schema.md)"
    ]
  }
}
